,"dx":0,"dy":8},{"page":3,"str":"Indicador de posesión :","x":199.3,"y":20,"dx":0,"dy":8},{"page":3,"str":"Descripción de cláusula del contrato :","x":235.3,"y":20,"dx":0,"dy":8},{"page":3,"str":"EL CONTRATO ESTABLECE UN CRÉDITO GARANTIZADO MEDIANTE GARANTÍA MOBILIARIA SOBRE EL BIEN FINANCIADO, CONFORME AL DECRETO LEGISLATIVO N° 1400 Y SU REGLAMENTO. LA GARANTÍA","x":247.4,"y":20,"dx":0,"dy":8},{"page":3,"str":"SE CONSTITUYE DESDE LA FIRMA DEL CONTRATO Y SE PUBLICITA EN EL SIGM DE SUNARP, OTORGANDO AL ACREEDOR DERECHOS PREFERENTES SOBRE EL BIEN SIN AFECTAR LA POSESIÓN DEL","x":256.7,"y":20,"dx":0,"dy":8},{"page":3,"str":"DEUDOR. EL OBJETO DEL CONTRATO ES GARANTIZAR OBLIGACIONES PRESENTES Y FUTURAS, DETERMINADAS O DETERMINABLES, MEDIANTE LA CONSTITUCIÓN DE UNA GARANTÍA MOBILIARIA SOBRE","x":266.1,"y":20,"dx":0,"dy":8},{"page":3,"str":"EL BIEN MUEBLE FINANCIADO. EL DEUDOR SE COMPROMETE A CUMPLIR CON LOS TÉRMINOS DE PAGO Y A NO DISPONER DEL BIEN SIN CONSENTIMIENTO DEL ACREEDOR. ADEMÁS, EL DEUDOR","x":275.4,"y":20,"dx":0,"dy":8},{"page":3,"str":"MANTIENE LA POSESIÓN DEL BIEN Y TIENE LA OBLIGACIÓN DE CONSERVARLO EN BUEN ESTADO, PERMITIENDO AL ACREEDOR INSPECCIONARLO CUANDO LO CONSIDERE NECESARIO. EN CASO DE","x":284.7,"y":20,"dx":0,"dy":8},{"page":3,"str":"INCUMPLIMIENTO DE LAS OBLIGACIONES, PROCEDE LA EJECUCIÓN JUDICIAL O EXTRAJUDICIAL DE LA GARANTÍA, EL ACREEDOR PODRÁ EJECUTAR LA GARANTÍA CONFORME A LA NORMATIVA VIGENTE,","x":294,"y":20,"dx":0,"dy":8},{"page":3,"str":"OPTANDO POR LA EJECUCIÓN DIRECTA, VENTA EN SUBASTA PÚBLICA O ADJUDICACIÓN DEL BIEN. LA EJECUCIÓN SE NOTIFICARÁ PREVIAMENTE AL DEUDOR DENTRO DE LOS PLAZOS ESTABLECIDOS EN","x":303.3,"y":20,"dx":0,"dy":8},{"page":3,"str":"LA LEY. LAS PARTES OTORGAN PODERES ESPECIFICO E IRREVOCABLE A FAVOR DE EL REPRESENTANTE INDICADO EN EL CONTRATO DE CONSTITUCIÓN DE GARANTÍA, A FIN DE QUE SE ENCUENTRE","x":312.6,"y":20,"dx":0,"dy":8},{"page":3,"str":"FACULTADO CON PODERES AMPLIOS Y SUFICIENTES PARA REALIZAR Y FORMALIZAR LA