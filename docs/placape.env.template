# /root/placape.env — plantilla (docs/vps-rebuild.md tiene el checklist de dónde sale cada valor).
# FORMATO: KEY=VALOR. Comentarios SOLO en línea propia. Este archivo GANA sobre el entorno de pm2.
# NUNCA subir este archivo lleno al repo (el repo es público).

# ── Núcleo (obligatorias) ────────────────────────────────────────────
# Supabase → Settings → API (service_role, NO el anon)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# CapSolver (captchas)
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=capsolver
# Display del Xvfb (proceso pm2 `xvfb`) para los Chrome del motor
DISPLAY=:99
# Rutas de trabajo
OPERATOR_OUT_BASE=/root/out
PLACAPE_DB=/root/data/placape.db

# ── Cuentas SPRL (historial registral) ───────────────────────────────
SPRL_USER=
SPRL_PASS=
SPRL_USER_2=
SPRL_PASS_2=
# (slot 3 de respaldo, opcional)
# SPRL_USER_3=
# SPRL_PASS_3=

# ── Motor (modo continuo, como estaba en producción) ─────────────────
ENGINE_CONTINUOUS=1
HISTORIAL_CONCURRENCY=2
KEEP_SUNARP_WARM=1
# Knobs opcionales (defaults sanos en el código):
# ENGINE_MAX_INFLIGHT=
# ENGINE_LIGHT_CONCURRENCY=
# BASIC_CONCURRENCY=
# MEMORY_NO_RERUN=fise-gnv,infogas-gnv

# ── Entrega a la web (correo/WhatsApp + preview de la consola) ───────
# El token debe COINCIDIR con OPERATOR_PREVIEW_TOKEN en Vercel (cópialo de ahí, no lo regeneres)
WEB_REPORT_URL=https://placape.pe
OPERATOR_PREVIEW_TOKEN=

# ── IA (reporte ULTRA) ───────────────────────────────────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ── SATT Trujillo (identidad de respaldo del registro; dueño empresa) ─
SATT_DNI=
SATT_CELULAR=
SATT_CORREO=

# ── Relay FISE (celular Termux) — genera token NUEVO y actualízalo en el celular ──
# openssl rand -hex 16
FISE_RELAY_TOKEN=

# ── Bot WhatsApp (n8n) — opcional hasta activar el bot ───────────────
# N8N_WEBHOOK_URL=https://TU-N8N/webhook/placape-listo

# ── Proxy de egreso (solo si lo usabas; iProyal u otro) ──────────────
# ENGINE_PROXY=
# ATU_PROXY=
