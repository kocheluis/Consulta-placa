{
  "name": "PlacaPe · 01 Inbound (consulta)",
  "nodes": [
    {
      "parameters": { "updates": ["messages"] },
      "id": "wa-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [260, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extrae el remitente y la placa del mensaje entrante (defensivo ante variaciones de forma).\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  const msg = (j.messages && j.messages[0]) || j.message || j;\n  const text = String((msg.text && msg.text.body) || j.body || '').trim();\n  const from = String(msg.from || (j.contacts && j.contacts[0] && j.contacts[0].wa_id) || j.from || '');\n  // placa = primer token de 6-7 alfanuméricos con al menos una letra y un dígito (evita 'CONSULTA').\n  let placa = '';\n  for (const w of text.split(/\\s+/)) {\n    const t = w.toUpperCase().replace(/[^A-Z0-9]/g, '');\n    if (t.length >= 6 && t.length <= 7 && /[0-9]/.test(t) && /[A-Z]/.test(t)) { placa = t; break; }\n  }\n  out.push({ json: { phone: from, text, placa } });\n}\nreturn out;"
      },
      "id": "extraer",
      "name": "Extraer datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.placa }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        }
      },
      "id": "if-placa",
      "name": "¿Placa válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PLACAPE_WEB_URL }}/api/bot/consulta",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-bot-token", "value": "={{ $env.BOT_API_TOKEN }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, placa: $json.placa }) }}",
        "options": {}
      },
      "id": "post-consulta",
      "name": "POST /api/bot/consulta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_ID }}",
        "recipientPhoneNumber": "={{ $('Extraer datos').item.json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.status === 'cupo_exceeded' ? '⚠️ Alcanzaste tu cupo de consultas por ' + $json.window + '. Vuelve en ~' + $json.resetInMin + ' min.' : ($json.status === 'invalid' ? '❌ No pude leer la placa. Envíala así: consulta ABC123' : '⏳ Generando tu reporte ' + ($json.tier || '') + ' de la placa ' + $json.placa + '. Te aviso apenas esté listo.') }}"
      },
      "id": "reply-ok",
      "name": "Responder (encolado)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1140, 220]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_ID }}",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "messageType": "text",
        "textBody": "👋 Envíame la placa que quieres consultar, así: *consulta ABC123*"
      },
      "id": "reply-help",
      "name": "Pedir placa",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [920, 400]
    }
  ],
  "connections": {
    "WhatsApp Trigger": { "main": [[{ "node": "Extraer datos", "type": "main", "index": 0 }]] },
    "Extraer datos": { "main": [[{ "node": "¿Placa válida?", "type": "main", "index": 0 }]] },
    "¿Placa válida?": {
      "main": [
        [{ "node": "POST /api/bot/consulta", "type": "main", "index": 0 }],
        [{ "node": "Pedir placa", "type": "main", "index": 0 }]
      ]
    },
    "POST /api/bot/consulta": { "main": [[{ "node": "Responder (encolado)", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "active": false
}
